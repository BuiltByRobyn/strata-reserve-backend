generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

// ============================================
// Lookup Tables
// ============================================

model UserType {
  userTypeId   Int       @id @default(autoincrement()) @map("user_type_id")
  userTypeName String    @unique @map("user_type_name") @db.VarChar(50)
  profiles     Profile[]

  @@map("user_type")
  @@schema("public")
}

model LegalType {
  legalTypeId        Int                  @id @default(autoincrement()) @map("legal_type_id")
  legalTypeName      String               @unique @map("legal_type_name") @db.VarChar(50)
  stratas            Strata[]

  @@map("legal_type")
  @@schema("public")
}

model PropertyType {
  propertyTypeId        Int                    @id @default(autoincrement()) @map("property_type_id")
  propertyTypeName      String                 @unique @map("property_type_name") @db.VarChar(100)
  description           String?                @db.Text
  sortOrder             Int                    @default(0) @map("sort_order")
  stratas               Strata[]
  questionPropertyTypes QuestionPropertyType[]
  strataPropertyTypes   StrataPropertyType[]
  strataProfilePropertyTypes StrataProfilePropertyType[]
  fnDocRequirements     FileNumberDocumentRequirement[]
  fileNumberDocuments FileNumberDocument[]
  surveyRequirements      FileNumberSurveyRequirement[]
  fnSurveyQuestions     FnSurveyQuestion[]
  questionResponses     QuestionResponse[]

  @@map("property_type")
  @@schema("public")
}

model Section {
  sectionId   Int    @id @default(autoincrement()) @map("section_id")
  sectionName String @unique @map("section_name") @db.VarChar(100)

  strataSections          StrataSection[]
  strataProfileSections   StrataProfileSection[]
  fileNumberDocuments FileNumberDocument[]

  @@map("section")
  @@schema("public")
}

model Service {
  serviceId          Int             @id @default(autoincrement()) @map("service_id")
  serviceName        String          @unique @map("service_name") @db.VarChar(100)
  serviceDescription String?         @map("service_description") @db.Text

  appointmentTypes AppointmentType[]
  fileNumbers  FileNumber[]

  questionServices  QuestionService[]

  @@map("service")
  @@schema("public")
}

model QuestionCategory {
  questionCategoryId Int      @id @default(autoincrement()) @map("question_category_id")
  key                String   @unique @db.VarChar(50)
  label              String   @unique @db.VarChar(100)
  description        String?  @db.Text
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  questions Question[]

  @@map("question_category")
  @@schema("public")
}

// ============================================
// Main Tables
// ============================================

model Profile {
  id                 String   @id @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  firstName          String?  @map("first_name") @db.Text
  lastName           String?  @map("last_name") @db.Text
  displayName        String?  @map("display_name") @db.Text
  email              String?  @db.Text
  phoneNumber        String?  @map("phone_number") @db.VarChar(20)
  userTypeId         Int?     @map("user_type_id")
  mustChangePassword Boolean? @default(true) @map("must_change_password")
  companyName        String?  @map("company_name") @db.VarChar(255)

  userType       UserType?       @relation(fields: [userTypeId], references: [userTypeId], onDelete: SetNull)
  strataProfiles StrataProfile[]
  strataNotes    StrataNotes[]

  requestedFileNumbers FileNumber[]     @relation("RequestedByProfile")
  requestedAppointments    AppointmentRequest[] @relation("AppointmentRequestedBy")
  reviewedAppointments     AppointmentReview[]  @relation("ReviewedByProfile")
  inspectorAppointments    Appointment[]        @relation("InspectorAppointments")
  offerInspectorRequests        FileNumber[]     @relation("OfferInspector")
  offerSecondInspectorRequests  FileNumber[]     @relation("OfferSecondInspector")

  inspectorAvailableDates InspectorAvailableDate[] @relation("InspectorAvailableDates")

  questionResponses QuestionResponse[]       @relation("AnsweredByProfile")
  uploadedDocuments FileNumberDocument[]     @relation("UploadedByProfile")

  reviewedPropertyTypeRequests PropertyTypeRequest[] @relation("ReviewedPropertyTypeRequests")
  reviewedActivationRequests   ActivationRequest[]   @relation("ReviewedActivationRequests")

  documentNaStatuses          FileNumberDocumentNaStatus[]
  adminDocumentReviews        FileNumberDocumentReview[]   @relation("AdminDocumentReviews")
  inAppNotifications          InAppNotification[]
  finalizedSurveyRequirements FileNumberSurveyRequirement[] @relation("SurveyRequirementFinalizer")

  @@map("profiles")
  @@schema("public")
}

model Strata {
  strataId       Int      @id @default(autoincrement()) @map("strata_id")
  strataPlan     String?  @map("strata_plan") @db.VarChar(100)
  complexName    String?  @map("complex_name") @db.VarChar(255)
  unitNumber     String?  @map("unit_number") @db.VarChar(50)
  streetName     String?  @map("street_name") @db.VarChar(255)
  town           String?  @db.VarChar(100)
  province       String?  @db.VarChar(100)
  postalCode     String?  @map("postal_code") @db.VarChar(20)
  country        String?  @default("Canada") @db.VarChar(100)
  website        String?  @db.VarChar(255)
  legalTypeId    Int?     @map("legal_type_id")
  propertyTypeId Int?     @map("property_type_id")
  companyName    String?   @map("company_name") @db.VarChar(255)
  locationId     Int?      @map("location_id")
  fiscalYearEnd  DateTime? @map("fiscal_year_end") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  legalType      LegalType?      @relation(fields: [legalTypeId], references: [legalTypeId], onDelete: SetNull)
  propertyType   PropertyType?   @relation(fields: [propertyTypeId], references: [propertyTypeId], onDelete: SetNull)
  location       Location?       @relation(fields: [locationId], references: [locationId], onDelete: SetNull)
  strataNotes    StrataNotes[]
  strataProfiles StrataProfile[]
  strataSections StrataSection[]
  strataPropertyTypes StrataPropertyType[]

  fileNumbers FileNumber[]

  @@map("strata")
  @@schema("public")
}

// ============================================
// Junction & Related Tables
// ============================================

model StrataNotes {
  noteId             Int      @id @default(autoincrement()) @map("note_id")
  noteMessage        String   @map("note_message") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdByUser      String?  @map("created_by_user") @db.VarChar(255)
  strataId           Int      @map("strata_id")
  createdByProfileId String?  @map("created_by_profile_id") @db.Uuid

  strata    Strata   @relation(fields: [strataId], references: [strataId], onDelete: Cascade)
  createdBy Profile? @relation(fields: [createdByProfileId], references: [id], onDelete: SetNull)

  @@map("strata_note")
  @@schema("public")
}

model StrataProfile {
  strataProfileId Int      @id @default(autoincrement()) @map("strata_profile_id")
  strataPosition  String?  @map("strata_position") @db.VarChar(100)
  strataId        Int      @map("strata_id")
  profileId       String   @map("profile_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  strata                     Strata                      @relation(fields: [strataId], references: [strataId], onDelete: Cascade)
  profile                    Profile                     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  strataProfileSections      StrataProfileSection[]
  strataProfilePropertyTypes StrataProfilePropertyType[]
  propertyTypeRequests       PropertyTypeRequest[]
  activationRequests         ActivationRequest[]
  profileActivityLogs        ProfileActivityLog[]

  @@unique([strataId, profileId])
  @@map("strata_profiles")
  @@schema("public")
}

model StrataSection {
  strataSectionId Int @id @default(autoincrement()) @map("strata_section_id")
  strataId        Int @map("strata_id")
  sectionId       Int @map("section_id")

  strata  Strata  @relation(fields: [strataId], references: [strataId], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [sectionId], onDelete: Cascade)

  @@unique([strataId, sectionId])
  @@map("strata_section")
  @@schema("public")
}

model StrataPropertyType {
  strataPropertyTypeId Int @id @default(autoincrement()) @map("strata_property_type_id")
  strataId             Int @map("strata_id")
  propertyTypeId       Int @map("property_type_id")

  strata       Strata       @relation(fields: [strataId], references: [strataId], onDelete: Cascade)
  propertyType PropertyType @relation(fields: [propertyTypeId], references: [propertyTypeId], onDelete: Cascade)

  @@unique([strataId, propertyTypeId])
  @@map("strata_property_type")
  @@schema("public")
}

model StrataProfileSection {
  strataProfileSectionId Int @id @default(autoincrement()) @map("strata_profile_section_id")
  strataProfileId        Int @map("strata_profile_id")
  sectionId              Int @map("section_id")

  strataProfile StrataProfile @relation(fields: [strataProfileId], references: [strataProfileId], onDelete: Cascade)
  section       Section       @relation(fields: [sectionId], references: [sectionId], onDelete: Cascade)

  @@unique([strataProfileId, sectionId])
  @@map("strata_profile_section")
  @@schema("public")
}

model StrataProfilePropertyType {
  strataProfilePropertyTypeId Int @id @default(autoincrement()) @map("strata_profile_property_type_id")
  strataProfileId             Int @map("strata_profile_id")
  propertyTypeId              Int @map("property_type_id")

  strataProfile StrataProfile @relation(fields: [strataProfileId], references: [strataProfileId], onDelete: Cascade)
  propertyType  PropertyType  @relation(fields: [propertyTypeId], references: [propertyTypeId], onDelete: Cascade)

  @@unique([strataProfileId, propertyTypeId])
  @@map("strata_profile_property_type")
  @@schema("public")
}

model PropertyTypeRequest {
  propertyTypeRequestId    Int       @id @default(autoincrement()) @map("property_type_request_id")
  strataProfileId          Int       @map("strata_profile_id")
  requestedPropertyTypeIds Int[]     @map("requested_property_type_ids")
  status                   String    @default("Pending") @db.VarChar(50)
  rejectionReason          String?   @map("rejection_reason") @db.Text
  reviewedByProfileId      String?   @map("reviewed_by_profile_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  reviewedAt               DateTime? @map("reviewed_at") @db.Timestamptz

  strataProfile StrataProfile @relation(fields: [strataProfileId], references: [strataProfileId], onDelete: Cascade)
  reviewedBy    Profile?      @relation("ReviewedPropertyTypeRequests", fields: [reviewedByProfileId], references: [id], onDelete: SetNull)

  @@map("property_type_request")
  @@schema("public")
}

model ActivationRequest {
  activationRequestId Int       @id @default(autoincrement()) @map("activation_request_id")
  strataProfileId     Int       @map("strata_profile_id")
  status              String    @default("Pending") @db.VarChar(50)
  rejectionReason     String?   @map("rejection_reason") @db.Text
  reviewedByProfileId String?   @map("reviewed_by_profile_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz

  strataProfile StrataProfile @relation(fields: [strataProfileId], references: [strataProfileId], onDelete: Cascade)
  reviewedBy    Profile?      @relation("ReviewedActivationRequests", fields: [reviewedByProfileId], references: [id], onDelete: SetNull)

  @@map("activation_request")
  @@schema("public")
}



// ============================================
// Appointment Lookup Tables
// ============================================

model ReviewStatus {
  reviewStatusId Int    @id @default(autoincrement()) @map("review_status_id")
  statusName     String @unique @map("status_name") @db.VarChar(50)

  appointmentReviews          AppointmentReview[]
  fileNumberDocuments         FileNumberDocument[]
  fileNumberDocumentReviewItems FileNumberDocumentReviewItem[]

  @@map("review_status")
  @@schema("public")
}

model AppointmentTimeSlot {
  timeSlotId Int    @id @default(autoincrement()) @map("time_slot_id")
  slotTime   String @map("slot_time") @db.VarChar(8)
  slotName   String @map("slot_name") @db.VarChar(10)

  appointmentTypeTimeSlots AppointmentTypeTimeSlot[]
  firstChoiceRequests      AppointmentRequest[]      @relation("FirstChoiceTimeSlot")
  secondChoiceRequests     AppointmentRequest[]      @relation("SecondChoiceTimeSlot")
  appointments             Appointment[]

  @@map("appointment_time_slot")
  @@schema("public")
}

// ============================================
// Appointment Type Tables
// ============================================

model AppointmentType {
  appointmentTypeId Int     @id @default(autoincrement()) @map("appointment_type_id")
  typeName          String  @map("type_name") @db.VarChar(100)
  durationType      String  @map("duration_type") @db.VarChar(20)
  description       String? @db.Text
  isDraftMeeting    Boolean @default(false) @map("is_draft_meeting")
  serviceId         Int     @map("service_id")

  service                  Service                   @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)
  appointmentTypeTimeSlots AppointmentTypeTimeSlot[]
  appointmentRequests      AppointmentRequest[]
  appointments             Appointment[]
  offerFileNumbers     FileNumber[]      @relation("OfferAppointmentType")

  @@map("appointment_type")
  @@schema("public")
}

model AppointmentTypeTimeSlot {
  appointmentTypeTimeSlotId Int @id @default(autoincrement()) @map("appointment_type_time_slot_id")
  appointmentTypeId         Int @map("appointment_type_id")
  timeSlotId                Int @map("time_slot_id")

  appointmentType AppointmentType     @relation(fields: [appointmentTypeId], references: [appointmentTypeId], onDelete: Cascade)
  timeSlot        AppointmentTimeSlot @relation(fields: [timeSlotId], references: [timeSlotId], onDelete: Cascade)

  @@unique([appointmentTypeId, timeSlotId])
  @@map("appointment_type_time_slot")
  @@schema("public")
}

// ============================================
// File Number Tables
// ============================================

model FileNumber {
  fileId             Int       @id @default(autoincrement()) @map("file_id")
  fileNumber         String?   @unique @map("file_number") @db.VarChar(20)
  requestDate            DateTime  @default(now()) @map("request_date") @db.Timestamptz
  status                 String    @db.VarChar(50)
  submittedForReviewDate DateTime? @map("submitted_for_review_date") @db.Timestamptz
  notes                  String?   @db.Text
  archived               Boolean   @default(false)
  archivedDate           DateTime? @map("archived_date") @db.Timestamptz
  serviceId              Int       @map("service_id")
  strataId               Int       @map("strata_id")
  requestedByProfileId   String?   @map("requested_by_profile_id") @db.Uuid

  fiscalYearEnd              DateTime? @map("fiscal_year_end") @db.Date
  lastAgmDate                DateTime? @map("last_agm_date") @db.Date
  noAgmToDate                Boolean   @default(false) @map("no_agm_to_date")
  lastDepreciationReportDate DateTime? @map("last_depreciation_report_date") @db.Date
  noReportToDate             Boolean   @default(false) @map("no_report_to_date")
  targetDate                 DateTime? @map("target_date") @db.Date
  timelinesSubmittedAt       DateTime? @map("timelines_submitted_at") @db.Timestamptz

  appointmentOfferedAt              DateTime? @map("appointment_offered_at") @db.Timestamptz
  appointmentOfferedByProfileId     String?   @map("appointment_offered_by_profile_id") @db.Uuid
  appointmentDueDate                DateTime? @map("appointment_due_date") @db.Date
  appointmentOfferTypeId            Int?      @map("appointment_offer_type_id")
  appointmentOfferInspectorId       String?   @map("appointment_offer_inspector_id") @db.Uuid
  appointmentOfferSecondInspectorId String?   @map("appointment_offer_second_inspector_id") @db.Uuid
  appointmentOfferNotes             String?   @map("appointment_offer_notes") @db.Text
  rebookingRequestedAt              DateTime? @map("rebooking_requested_at") @db.Timestamptz

  service                Service              @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)
  strata                 Strata               @relation(fields: [strataId], references: [strataId], onDelete: Cascade)
  requestedBy            Profile?             @relation("RequestedByProfile", fields: [requestedByProfileId], references: [id], onDelete: SetNull)
  appointmentOfferType   AppointmentType?     @relation("OfferAppointmentType", fields: [appointmentOfferTypeId], references: [appointmentTypeId], onDelete: SetNull)
  appointmentOfferInspector Profile?           @relation("OfferInspector", fields: [appointmentOfferInspectorId], references: [id], onDelete: SetNull)
  appointmentOfferSecondInspector Profile?     @relation("OfferSecondInspector", fields: [appointmentOfferSecondInspectorId], references: [id], onDelete: SetNull)
  appointmentRequests    AppointmentRequest[]
  appointments           Appointment[]

  questionResponses       QuestionResponse[]
  fileNumberDocuments     FileNumberDocument[]
  documentRequirements    FileNumberDocumentRequirement[]
  surveyRequirements      FileNumberSurveyRequirement[]
  fnSurveyQuestions       FnSurveyQuestion[]
  documentReviews         FileNumberDocumentReview[]
  inAppNotifications      InAppNotification[]

  @@map("file_number")
  @@schema("public")
}

model FileNumberSurveyRequirement {
  fnSurveyRequirementId Int       @id @default(autoincrement()) @map("fn_survey_requirement_id")
  fileId                Int       @map("file_id")
  propertyTypeId        Int       @map("property_type_id")
  finalizedAt           DateTime? @map("finalized_at") @db.Timestamptz
  finalizedByProfileId  String?   @map("finalized_by_profile_id") @db.Uuid

  fileNumber   FileNumber   @relation(fields: [fileId], references: [fileId], onDelete: Cascade)
  propertyType PropertyType @relation(fields: [propertyTypeId], references: [propertyTypeId], onDelete: Cascade)
  finalizedBy  Profile?     @relation("SurveyRequirementFinalizer", fields: [finalizedByProfileId], references: [id], onDelete: SetNull)

  @@unique([fileId, propertyTypeId])
  @@map("fn_survey_requirement")
  @@schema("public")
}

// ============================================
// Appointment Request & Review Tables
// ============================================

model AppointmentRequest {
  appointmentRequestId   Int       @id @default(autoincrement()) @map("appointment_request_id")
  firstChoiceDate        DateTime  @map("first_choice_date") @db.Date
  secondChoiceDate       DateTime? @map("second_choice_date") @db.Date
  specialRequirements    String?   @map("special_requirements") @db.Text
  status                 String    @db.VarChar(50)
  requestDate            DateTime  @default(now()) @map("request_date") @db.Timestamptz
  fileId       Int       @map("file_id")
  appointmentTypeId      Int       @map("appointment_type_id")
  firstChoiceTimeSlotId  Int       @map("first_choice_time_slot_id")
  secondChoiceTimeSlotId Int?      @map("second_choice_time_slot_id")
  requestedByProfileId   String?   @map("requested_by_profile_id") @db.Uuid

  fileNumber       FileNumber       @relation(fields: [fileId], references: [fileId], onDelete: Cascade)
  appointmentType      AppointmentType      @relation(fields: [appointmentTypeId], references: [appointmentTypeId], onDelete: Cascade)
  firstChoiceTimeSlot  AppointmentTimeSlot  @relation("FirstChoiceTimeSlot", fields: [firstChoiceTimeSlotId], references: [timeSlotId], onDelete: Cascade)
  secondChoiceTimeSlot AppointmentTimeSlot? @relation("SecondChoiceTimeSlot", fields: [secondChoiceTimeSlotId], references: [timeSlotId], onDelete: SetNull)
  requestedBy          Profile?             @relation("AppointmentRequestedBy", fields: [requestedByProfileId], references: [id], onDelete: SetNull)
  appointmentReviews   AppointmentReview[]
  appointments         Appointment[]

  @@map("appointment_request")
  @@schema("public")
}

model AppointmentReview {
  appointmentReviewId  Int      @id @default(autoincrement()) @map("appointment_review_id")
  reviewDate           DateTime @default(now()) @map("review_date") @db.Timestamptz
  approvedDateChoice   Int?     @map("approved_date_choice")
  comments             String?  @db.Text
  rejectionReason      String?  @map("rejection_reason") @db.Text
  appointmentRequestId Int      @map("appointment_request_id")
  reviewedByProfileId  String?  @map("reviewed_by_profile_id") @db.Uuid
  reviewStatusId       Int      @map("review_status_id")

  appointmentRequest AppointmentRequest @relation(fields: [appointmentRequestId], references: [appointmentRequestId], onDelete: Cascade)
  reviewedBy         Profile?           @relation("ReviewedByProfile", fields: [reviewedByProfileId], references: [id], onDelete: SetNull)
  reviewStatus       ReviewStatus       @relation(fields: [reviewStatusId], references: [reviewStatusId], onDelete: Cascade)

  @@map("appointment_review")
  @@schema("public")
}

// ============================================
// Appointment Table
// ============================================

model Appointment {
  appointmentId        Int       @id @default(autoincrement()) @map("appointment_id")
  appointmentDate      DateTime  @map("appointment_date") @db.Date
  status               String    @db.VarChar(50)
  completionNote       String?   @map("completion_note") @db.Text
  completedAt          DateTime? @map("completed_at") @db.Timestamptz
  cancellationReason   String?   @map("cancellation_reason") @db.Text
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz
  rescheduleReason     String?   @map("reschedule_reason") @db.Text
  appointmentRequestId Int?      @map("appointment_request_id")
  fileId     Int       @map("file_id")
  appointmentTypeId    Int       @map("appointment_type_id")
  timeSlotId           Int       @map("time_slot_id")
  inspectorProfileId   String?   @map("inspector_profile_id") @db.Uuid

  appointmentRequest AppointmentRequest?  @relation(fields: [appointmentRequestId], references: [appointmentRequestId], onDelete: Cascade)
  fileNumber     FileNumber      @relation(fields: [fileId], references: [fileId], onDelete: Cascade)
  appointmentType    AppointmentType     @relation(fields: [appointmentTypeId], references: [appointmentTypeId], onDelete: Cascade)
  timeSlot           AppointmentTimeSlot @relation(fields: [timeSlotId], references: [timeSlotId], onDelete: Cascade)
  inspector          Profile?            @relation("InspectorAppointments", fields: [inspectorProfileId], references: [id], onDelete: SetNull)

  @@map("appointment")
  @@schema("public")
}

// ============================================
// Inspector Availability Table
// ============================================

model InspectorAvailableDate {
  inspectorAvailableDateId Int       @id @default(autoincrement()) @map("inspector_available_date_id")
  availableStartDate       DateTime  @map("available_start_date") @db.Date
  availableEndDate         DateTime  @map("available_end_date") @db.Date
  availableStartTime       DateTime? @map("available_start_time") @db.Time()
  availableEndTime         DateTime? @map("available_end_time") @db.Time()
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  inspectorProfileId       String    @map("inspector_profile_id") @db.Uuid

  inspectorProfile Profile @relation("InspectorAvailableDates", fields: [inspectorProfileId], references: [id], onDelete: Cascade)
  locations        InspectorAvailableLocation[]

  @@map("inspector_available_date")
  @@schema("public")
}

model InspectorAvailableLocation {
  inspectorAvailableLocationId Int    @id @default(autoincrement()) @map("inspector_available_location_id")
  inspectorAvailableDateId     Int    @map("inspector_available_date_id")
  locationCode                 String @map("location_code") @db.VarChar(10)

  availableDate InspectorAvailableDate @relation(fields: [inspectorAvailableDateId], references: [inspectorAvailableDateId], onDelete: Cascade)

  @@unique([inspectorAvailableDateId, locationCode])
  @@map("inspector_available_location")
  @@schema("public")
}

// ============================================
// Location Table
// ============================================

model Location {
  locationId   Int    @id @default(autoincrement()) @map("location_id")
  locationCode String @unique @map("location_code") @db.VarChar(10)
  locationName String @map("location_name") @db.VarChar(100)

  stratas Strata[]

  @@map("location")
  @@schema("public")
}

// ============================================
// Company Holiday Table
// ============================================

model CompanyHoliday {
  companyHolidayId    Int      @id @default(autoincrement()) @map("company_holiday_id")
  holidayDate         DateTime @map("holiday_date") @db.Date
  holidayName         String   @map("holiday_name") @db.VarChar(100)
  isRecurringAnnually Boolean  @default(false) @map("is_recurring_annually")

  @@map("company_holiday")
  @@schema("public")
}

// ============================================
// SURVEY/QUESTIONNAIRE TABLES
// ============================================

model QuestionType {
  questionTypeId   Int        @id @default(autoincrement()) @map("question_type_id")
  questionTypeName String     @unique @map("question_type_name") @db.VarChar(50)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  questions        Question[]

  @@map("question_type")
  @@schema("public")
}

model Question {
  questionId       Int      @id @default(autoincrement()) @map("question_id")
  subLabel         String?  @map("sub_label") @db.VarChar(10)
  questionText     String   @map("question_text") @db.Text
  isRequired       Boolean  @map("is_required")
  allowNa          Boolean  @default(false) @map("allow_na")
  allowUnavailable Boolean  @default(false) @map("allow_unavailable")
  informationText  String?  @map("information_text") @db.Text
  questionCategoryId Int              @map("question_category_id")
  questionTypeId     Int              @map("question_type_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parentRelations QuestionSubQuestion[] @relation("ParentRelations")
  subRelations    QuestionSubQuestion[] @relation("SubRelations")

  questionCategory      QuestionCategory       @relation(fields: [questionCategoryId], references: [questionCategoryId], onDelete: Restrict)
  questionType          QuestionType           @relation(fields: [questionTypeId], references: [questionTypeId], onDelete: Cascade)
  questionServices      QuestionService[]
  multipleChoiceOptions MultipleChoiceOption[]
  questionPropertyTypes QuestionPropertyType[]
  questionResponses     QuestionResponse[]     @relation("QuestionResponses")
  parentContextResponses QuestionResponse[]    @relation("ParentContextRelation")
  fnSurveyQuestions     FnSurveyQuestion[]

  @@map("question")
  @@schema("public")
}

model QuestionSubQuestion {
  id               Int @id @default(autoincrement())
  parentQuestionId Int @map("parent_question_id")
  subQuestionId    Int @map("sub_question_id")
  sortOrder        Int @default(0) @map("sort_order")

  parentQuestion Question @relation("ParentRelations", fields: [parentQuestionId], references: [questionId], onDelete: Cascade)
  subQuestion    Question @relation("SubRelations", fields: [subQuestionId], references: [questionId], onDelete: Cascade)

  @@unique([parentQuestionId, subQuestionId])
  @@map("question_sub_question")
  @@schema("public")
}

model QuestionService {
  questionServiceId Int @id @default(autoincrement()) @map("question_service_id")
  sortOrder         Int @map("sort_order")
  questionId        Int @map("question_id")
  serviceId         Int @map("service_id")

  question Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)

  @@unique([questionId, serviceId])
  @@map("question_service")
  @@schema("public")
}

model MultipleChoiceOption {
  multipleChoiceOptionId Int    @id @default(autoincrement()) @map("multiple_choice_option_id")
  sortOrder              Int    @map("sort_order")
  optionText             String @map("option_text") @db.VarChar(255)
  questionId             Int    @map("question_id")

  question          Question           @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  questionResponses QuestionResponse[]

  @@map("multiple_choice_option")
  @@schema("public")
}

model QuestionPropertyType {
  questionPropertyTypeId Int @id @default(autoincrement()) @map("question_property_type_id")
  questionId             Int @map("question_id")
  propertyTypeId         Int @map("property_type_id")

  question     Question     @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  propertyType PropertyType @relation(fields: [propertyTypeId], references: [propertyTypeId], onDelete: Cascade)

  @@unique([questionId, propertyTypeId])
  @@map("question_property_type")
  @@schema("public")
}



model QuestionResponse {
  responseId             Int       @id @default(autoincrement()) @map("response_id")
  responseText           String?   @map("response_text") @db.Text
  responseDate           DateTime? @map("response_date") @db.Date
  responseNumber         Int?      @map("response_number")
  responseBoolean        Boolean?  @map("response_boolean")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt             DateTime? @map("archived_at") @db.Timestamptz
  fileId       Int       @map("file_id")
  answeredByProfileId    String?   @map("answered_by_profile_id") @db.Uuid
  questionId             Int       @map("question_id")
  propertyTypeId         Int       @map("property_type_id")
  parentQuestionId       Int?      @map("parent_question_id")
  multipleChoiceOptionId Int?      @map("multiple_choice_option_id")

  fileNumber       FileNumber        @relation(fields: [fileId], references: [fileId], onDelete: Cascade)
  answeredBy           Profile?              @relation("AnsweredByProfile", fields: [answeredByProfileId], references: [id], onDelete: SetNull)
  question             Question              @relation("QuestionResponses", fields: [questionId], references: [questionId], onDelete: Cascade)
  parentQuestion       Question?             @relation("ParentContextRelation", fields: [parentQuestionId], references: [questionId], onDelete: SetNull)
  propertyType         PropertyType          @relation(fields: [propertyTypeId], references: [propertyTypeId], onDelete: Cascade)
  multipleChoiceOption MultipleChoiceOption? @relation(fields: [multipleChoiceOptionId], references: [multipleChoiceOptionId], onDelete: SetNull)

  @@map("question_response")
  @@schema("public")
}

model FnSurveyQuestion {
  fnSurveyQuestionId Int @id @default(autoincrement()) @map("fn_survey_question_id")
  fileId             Int @map("file_id")
  questionId         Int @map("question_id")
  propertyTypeId     Int @map("property_type_id")
  sortOrder          Int @default(0) @map("sort_order")

  fileNumber FileNumber @relation(fields: [fileId], references: [fileId], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  propertyType   PropertyType   @relation(fields: [propertyTypeId], references: [propertyTypeId], onDelete: Cascade)

  @@unique([fileId, questionId, propertyTypeId])
  @@map("fn_survey_question")
  @@schema("public")
}

// ============================================
// DOCUMENT TABLES
// ============================================

model DocumentType {
  documentTypeId          Int                      @id @default(autoincrement()) @map("document_type_id")
  typeName                String                   @unique @map("type_name") @db.VarChar(100)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  fileNumberDocuments FileNumberDocument[]
  fnDocRequirements       FileNumberDocumentRequirement[]

  @@map("document_type")
  @@schema("public")
}

model FileNumberDocument {
  fileNumberDocumentId    Int      @id @default(autoincrement()) @map("file_number_document_id")
  filePath                String   @map("file_path") @db.VarChar(500)
  fileName                String   @map("file_name") @db.VarChar(255)
  fileSize                Int      @map("file_size")
  uploadedAt              DateTime @default(now()) @map("uploaded_at") @db.Timestamptz
  notes                   String?  @db.Text
  fileId                  Int      @map("file_id")
  documentTypeId          Int      @map("document_type_id")
  uploadedByProfileId     String?  @map("uploaded_by_profile_id") @db.Uuid
  reviewStatusId          Int?     @map("review_status_id")
  sectionId               Int?     @map("section_id")
  propertyTypeId          Int?     @map("property_type_id")
  fnDocRequirementId      Int?     @map("fn_doc_requirement_id")

  fileNumber    FileNumber                      @relation(fields: [fileId], references: [fileId], onDelete: Cascade)
  documentType  DocumentType                    @relation(fields: [documentTypeId], references: [documentTypeId], onDelete: Cascade)
  uploadedBy    Profile?                        @relation("UploadedByProfile", fields: [uploadedByProfileId], references: [id], onDelete: SetNull)
  reviewStatus  ReviewStatus?                   @relation(fields: [reviewStatusId], references: [reviewStatusId], onDelete: SetNull)
  section       Section?                        @relation(fields: [sectionId], references: [sectionId], onDelete: SetNull)
  propertyType  PropertyType?                   @relation(fields: [propertyTypeId], references: [propertyTypeId], onDelete: SetNull)
  requirement   FileNumberDocumentRequirement?  @relation(fields: [fnDocRequirementId], references: [fnDocRequirementId], onDelete: SetNull)

  @@map("file_number_document")
  @@schema("public")
}

model FileNumberDocumentRequirement {
  fnDocRequirementId Int     @id @default(autoincrement()) @map("fn_doc_requirement_id")
  fileId             Int     @map("file_id")
  documentTypeId     Int     @map("document_type_id")
  propertyTypeId     Int?    @map("property_type_id")
  isRequired         Boolean @default(true) @map("is_required")
  quantity           Int     @default(1)
  notes              String? @db.Text
  versionLabel       String  @default("") @map("version_label") @db.VarChar(100)

  fileNumber        FileNumber                   @relation(fields: [fileId], references: [fileId], onDelete: Cascade)
  documentType      DocumentType                 @relation(fields: [documentTypeId], references: [documentTypeId], onDelete: Cascade)
  propertyType      PropertyType?                @relation(fields: [propertyTypeId], references: [propertyTypeId], onDelete: SetNull)
  fileNumberDocuments FileNumberDocument[]
  naStatus          FileNumberDocumentNaStatus?
  reviewItems       FileNumberDocumentReviewItem[]

  @@unique([fileId, documentTypeId, propertyTypeId, versionLabel])
  @@map("fn_document_requirement")
  @@schema("public")
}

model FileNumberDocumentNaStatus {
  naStatusId         Int      @id @default(autoincrement()) @map("na_status_id")
  fnDocRequirementId Int      @unique @map("fn_doc_requirement_id")
  status             String   @map("status") @db.VarChar(20)
  setByProfileId     String?  @map("set_by_profile_id") @db.Uuid
  setAt              DateTime @default(now()) @map("set_at") @db.Timestamptz

  requirement FileNumberDocumentRequirement @relation(fields: [fnDocRequirementId], references: [fnDocRequirementId], onDelete: Cascade)
  setBy       Profile?                      @relation(fields: [setByProfileId], references: [id], onDelete: SetNull)

  @@map("fn_document_na_status")
  @@schema("public")
}

model FileNumberDocumentReview {
  reviewId            Int       @id @default(autoincrement()) @map("review_id")
  fileId              Int       @map("file_id")
  reviewedByProfileId String?   @map("reviewed_by_profile_id") @db.Uuid
  reviewedAt          DateTime  @default(now()) @map("reviewed_at") @db.Timestamptz
  clientNotifiedAt    DateTime? @map("client_notified_at") @db.Timestamptz

  fileNumber FileNumber                     @relation(fields: [fileId], references: [fileId], onDelete: Cascade)
  reviewedBy Profile?                       @relation("AdminDocumentReviews", fields: [reviewedByProfileId], references: [id], onDelete: SetNull)
  items      FileNumberDocumentReviewItem[]

  @@map("fn_document_review")
  @@schema("public")
}

model FileNumberDocumentReviewItem {
  reviewItemId       Int     @id @default(autoincrement()) @map("review_item_id")
  reviewId           Int     @map("review_id")
  fnDocRequirementId Int     @map("fn_doc_requirement_id")
  reviewStatusId     Int     @map("review_status_id")
  notes              String? @db.Text

  review       FileNumberDocumentReview      @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)
  requirement  FileNumberDocumentRequirement @relation(fields: [fnDocRequirementId], references: [fnDocRequirementId], onDelete: Cascade)
  reviewStatus ReviewStatus                  @relation(fields: [reviewStatusId], references: [reviewStatusId], onDelete: Cascade)

  @@unique([reviewId, fnDocRequirementId])
  @@map("fn_document_review_item")
  @@schema("public")
}

model InAppNotification {
  notificationId Int       @id @default(autoincrement()) @map("notification_id")
  profileId      String    @map("profile_id") @db.Uuid
  fileId         Int?      @map("file_id")
  type           String    @map("type") @db.VarChar(50)
  message        String    @map("message") @db.Text
  isRead         Boolean   @default(false) @map("is_read")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  referenceId    Int?      @map("reference_id")

  profile    Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  fileNumber FileNumber? @relation(fields: [fileId], references: [fileId], onDelete: SetNull)

  @@map("in_app_notification")
  @@schema("public")
}

model ProfileActivityLog {
  activityLogId   Int           @id @default(autoincrement()) @map("activity_log_id")
  strataProfileId Int           @map("strata_profile_id")
  changedFields   Json          @map("changed_fields")
  changedAt       DateTime      @default(now()) @map("changed_at") @db.Timestamptz

  strataProfile StrataProfile @relation(fields: [strataProfileId], references: [strataProfileId])

  @@map("profile_activity_log")
  @@schema("public")
}
